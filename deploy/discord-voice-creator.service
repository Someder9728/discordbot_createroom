[Unit]
Description=Discord permanent voice channel creator
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=discordbot
Group=discordbot
WorkingDirectory=/opt/discord-voice-creator
ExecStart=/opt/discord-voice-creator/.venv/bin/python -u /opt/discord-voice-creator/bot.py
Restart=on-failure
RestartSec=15
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
Environment=PYTHONDONTWRITEBYTECODE=1

[Install]
WantedBy=multi-user.target
